{
  "name": "code-agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run apps/cli/src/main.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:language": "bun run scripts/audit-language.ts",
    "build": "bun build apps/cli/src/main.tsx --target=bun --packages=external --outfile=dist/agent-harness.js",
    "eval": "bun run scripts/eval.ts",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:live": "bun run scripts/smoke-live.ts",
    "quality": "bun run format:check && bun run lint && bun run typecheck && bun run build && bun run test && bun run smoke"
  },
  "dependencies": {
    "execa": "^9.6.0",
    "ink": "^6.2.3",
    "openai": "^5.19.1",
    "react": "^19.2.0",
    "simple-git": "^3.28.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "^1.3.1",
    "@types/react": "^19.2.2",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
